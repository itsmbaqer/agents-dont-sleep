{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agents Don't Sleep",
  "mainBinaryName": "agents-dont-sleep",
  "version": "../package.json",
  "identifier": "iq.starsphere.agentsdontsleep",
  "build": {
    "beforeDevCommand": "node scripts/build-hook.mjs && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node scripts/build-hook.mjs && pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Keeps your laptop awake, lid shut, while coding agents work",
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/adshook"
    ],
    "publisher": "Mohammed Baqer",
    "copyright": "\u00a9 2026 Mohammed Baqer. MIT License.",
    "homepage": "https://github.com/itsmbaqer/agents-dont-sleep",
    "license": "MIT",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "libayatana-appindicator-gtk3"
        ]
      }
    }
  }
}
