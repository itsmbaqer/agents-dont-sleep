{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agents Don't Sleep",
  "mainBinaryName": "agents-dont-sleep",
  "version": "0.1.0",
  "identifier": "iq.starsphere.agentsdontsleep",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "shortDescription": "Keeps your Mac awake, lid shut, while coding agents work",
    "macOS": { "minimumSystemVersion": "14.0" },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
